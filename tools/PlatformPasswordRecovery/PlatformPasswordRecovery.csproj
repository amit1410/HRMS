<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <NuGetAudit>false</NuGetAudit>
    <NoWarn>$(NoWarn);NU1900</NoWarn>
    <!-- The offline utility must build project references serially. The SDK's parallel
         target-framework probe can fail with a misleading zero-error project-reference
         failure in the managed build environment. -->
    <BuildInParallel>false</BuildInParallel>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../Backend/HRMS.Infrastructure/HRMS.Infrastructure.csproj" />
  </ItemGroup>
</Project>
