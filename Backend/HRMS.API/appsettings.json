{
  "Database": {
    "Provider": "MySql",
    "StartupMode": "Validate",
    "SkipInitialization": false,
    "SeedDemoTenants": false,
    "AllowSqliteDestructiveRebuild": false
  },
  "MigrationHost": {
    "AllowedCatalogs": [],
    "AllowedTenants": [],
    "RequiredEnvironment": "",
    "AllowedApprovals": []
  },
  "ConnectionStrings": {
    "Catalog": "",
    "SqliteCatalog": "Data Source=hrms-catalog.db",
    "Sqlite": "Data Source=hrms.db"
  },
  "Sharding": {
    "MySqlConnectionStringTemplate": "",
    "SqliteConnectionStringTemplate": "",
    "CacheSeconds": 30,
    "UnknownHostCacheSeconds": 5
  },
  "Invitations": {
    "InitialPasswordExpiryHours": 24
  },
  "Email": {
    "FromEmail": "amit@anevratechnologies.com",
    "FromName": "Anevra HRMS"
  },
  "LeaveReminders": {
    "Enabled": false,
    "InitialDelayHours": 24,
    "RepeatIntervalHours": 24,
    "WorkerIntervalMinutes": 15,
    "BatchSize": 100,
    "MaxAttempts": 3,
    "ClaimLeaseMinutes": 30
  },
  "ConfirmationReminders": {
    "Enabled": false,
    "WorkerIntervalMinutes": 15,
    "DefaultFrequencyMinutes": 60,
    "BatchSize": 200,
    "MaxAttempts": 3,
    "ClaimLeaseMinutes": 30,
    "RetryBackoffMinutes": 60,
    "DefaultTriggerDaysBeforeEnd": 30
  },
  "Frontend": {
    "TenantWebUrlTemplate": "https://{host}",
    "PlatformWebUrl": "https://platform.example.com"
  },
  "Jwt": {
    "Issuer": "HRMS.API",
    "Audience": "HRMS.Client",
    "SecretKey": "",
    "AccessTokenMinutes": 60,
    "RefreshTokenDays": 7,
    "ClockSkewSeconds": 30
  },
  "PlatformJwt": {
    "Issuer": "HRMS.Platform",
    "Audience": "HRMS.Platform.Client",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 14,
    "ClockSkewSeconds": 30
  },
  "Platform": {
    "AllowedHosts": []
  },
  "RateLimiting": {
    "Authentication": {
      "PermitLimit": 20,
      "WindowSeconds": 60
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "https://localhost:5173"
    ],
    "WorkspaceOriginTemplates": []
  },
  "ForwardedHeaders": {
    "KnownProxies": [],
    "KnownNetworks": [],
    "ForwardLimit": 1
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/hrms-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "AllowedHosts": "*"
}
