{
  "Database": {
    "Provider": "Sqlite"
  },
  "Jwt": {
    "SecretKey": "dev-only-super-secret-signing-key-change-me-32bytes-minimum!!"
  },
  "Cors": {
    "WorkspaceOriginTemplates": [
      "http://{workspace}.localhost:5173",
      "https://{workspace}.localhost:5173"
    ]
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Information"
      }
    }
  }
}
