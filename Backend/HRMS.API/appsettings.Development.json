    "Smtp": {
      "Host": "smtp.hostinger.com",
      "Port": 587,
      "Username": "noreply@anevratechnology.com",
      "EnableSsl": true
    }
  },

  "Sms": {
    "Provider": "Fake"
  },

  "Frontend": {
    "TenantWebUrlTemplate": "http://{host}:5173"
  },

