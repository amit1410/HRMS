{
  "Database": {
    "Provider": "MySql",
    "CatalogProvider": "MySql",
    "SeedDemoTenants": false
  },

  "ConnectionStrings": {
    "Catalog": ""
  },

  "Sharding": {
    "MySqlConnectionStringTemplate": "",
    "CacheSeconds": 30,
    "UnknownHostCacheSeconds": 5
  },

  "Invitations": {
    "InitialPasswordExpiryHours": 24
  },

  "Frontend": {
    "TenantWebUrlTemplate": "http://{host}:5173"
  },

  "Jwt": {
    "SecretKey": "dev-only-super-secret-signing-key-change-me-32bytes-minimum!!"
  },

  "Platform": {
    "AllowedHosts": [ "platform.localhost" ]
  },

  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "https://localhost:5173",
      "http://platform.localhost:5173"
    ],
    "WorkspaceOriginTemplates": [
      "http://{workspace}.localhost:5173",
      "https://{workspace}.localhost:5173"
    ]
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Information"
      }
    }
  }
}
