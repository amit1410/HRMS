# Base URL of the HRMS API. No trailing slash.
#
# The dev default (http://localhost:5080) matches the API's `http` launch profile and is one of the
# origins its CORS policy allows. Point this at the deployed API for a real build — it is baked in at
# build time, so a production bundle must be built with the production value.
VITE_API_BASE_URL=http://localhost:5080

# Workspace-aware API routing, used only when a page is served from a labeled host
# (`demo01.localhost:5173` calls the API at `demo01.localhost:5080`). Leave unset to keep every
# request on VITE_API_BASE_URL. Development-focused today; a deployment that serves workspaces from
# real hosts would set it to that deployment's own template — none is invented here.
#VITE_API_ORIGIN_TEMPLATE=http://{workspace}.localhost:5080
