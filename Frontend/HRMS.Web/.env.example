# Base URL of the HRMS API. No trailing slash.
#
# The dev default (http://localhost:5080) matches the API's `http` launch profile and is one of the
# origins its CORS policy allows. Point this at the deployed API for a real build — it is baked in at
# build time, so a production bundle must be built with the production value.
VITE_API_BASE_URL=http://localhost:5080
