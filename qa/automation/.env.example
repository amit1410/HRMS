# Copy this file to `.env` (already git-ignored) and fill in values for a disposable QA
# environment. Never commit a real .env file, and never put real credentials in source control.
#
# Naming follows the convention already used in qa/01-authentication/README.md: hosts and users
# are logical names resolved from environment variables at run time, never literal strings in
# test code or case files.

# --- Environment / URLs ---
# Scheme and ports the local dev stack listens on (see CLAUDE.md: API on 5080, Vite on 5173).
QA_SCHEME=http
QA_UI_PORT=5173
QA_API_PORT=5080

# --- Tenant A (primary QA tenant) ---
# Host only — no scheme, no port — e.g. anevra01.localhost or demo01.localhost. This is the
# {workspace} the frontend's VITE_API_ORIGIN_TEMPLATE substitutes, and the Host header API tests
# send directly.
QA_TENANT_A_HOST=

# Credentials for a disposable QA user in Tenant A (any role with dashboard access). Sourced only
# from the environment / a local .env — never hard-coded in test files. Tests that need these
# pytest.skip() (not fail) when they're unset. Never a production account.
# QA_A_ADMIN_USERNAME accepts either an email or an employee code, matching whatever
# loginIdentifierMode the tenant's branding uses (see GET /api/tenants/current/branding). For
# ANEVRA01 specifically (loginIdentifierMode=EmployeeCodeOnly), use the QA Admin's email — a
# TenantAdmin/SuperAdmin account is deliberately never locked out of EmployeeCodeOnly mode (see
# AuthService.LoginAsync) — provisioned by Backend/HRMS.Infrastructure/Persistence/Seed/
# DatabaseSeeder.cs's SeedQaAutomationUsersAsync; see qa/automation/README.md "Phase 6" for how to
# provision/rotate/remove it.
QA_A_ADMIN_USERNAME=
QA_A_ADMIN_PASSWORD=

# A disposable QA user in Tenant A holding only the plain, self-service `Employee` role (no
# Employee.View/.Create/.Edit — see Backend/HRMS.Infrastructure/Persistence/Seed/SeedData.cs
# RolePermissionMap[RoleNames.Employee]). Used only for the Employee-module authorization-denial
# check (EMP-SEC-002); that one test skips on its own if this pair is unset.
# For ANEVRA01, this account has no email login fallback in EmployeeCodeOnly mode — use its
# Employee Code (QAAUTO-EMP) as the identifier, not its email.
QA_A_EMPLOYEE_USERNAME=
QA_A_EMPLOYEE_PASSWORD=

# A disposable QA user in Tenant A holding the `Manager` role (grants Leave.Approve, among other
# team-scoped permissions — see SeedData.cs RolePermissionMap[RoleNames.Manager]). Used only for
# the Leave-module approval-inbox checks; those tests skip on their own if this pair is unset.
# For ANEVRA01, use its Employee Code (QAAUTO-MGR) as the identifier — see QA_A_EMPLOYEE_USERNAME
# above for why.
QA_A_MANAGER_USERNAME=
QA_A_MANAGER_PASSWORD=

# A host guaranteed not to resolve to any tenant, used for negative host-resolution tests.
# The default below is fine to keep as-is.
QA_UNKNOWN_HOST=qa-unregistered-workspace.localhost

# --- Execution ---
# true/false. Leave unset to use whatever pytest-playwright's --headed flag decides.
#QA_HEADLESS=true
QA_LOG_LEVEL=INFO

# --- CI pacing and state (optional locally; CI sets them — see docs/qa/automation-ci.md) ---
# Pace tests under the API's auth rate limit (20 sign-in/refresh/branding requests per 60s per
# tenant and client IP). Unset means no pacing. 18 leaves a margin of 2 under the server's 20.
#QA_AUTH_RATE_BUDGET=18
# Reuse one API sign-in per identity for the whole run instead of one per test.
#QA_REUSE_API_SESSIONS=1
# Directory holding the payroll sandbox manifest. Default: qa/automation/.state. There must be only
# one manifest per tenant, so a CI runner on this machine should point at the same directory.
#QA_SANDBOX_STATE_DIR=
